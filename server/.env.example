# Copie ce fichier en ".env" (dans server/) et remplis les valeurs.
# Sans clé pour un fournisseur, son bouton de connexion sociale reste
# désactivé côté site — rien ne casse, aucune clé n'est obligatoire.

# --- Général ---------------------------------------------------------------
PORT=3000
BASE_URL=http://localhost:3000
# Génère une vraie valeur secrète avant toute mise en ligne, ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-avant-la-mise-en-ligne

# Clé pour accéder au tableau de bord des commandes/stats (voir admin.html).
# Sans elle, /api/orders et /api/stats sont bloqués — personne (même toi) ne
# peut lire les données clients. Génère une valeur avec la même commande que
# JWT_SECRET ci-dessus.
ADMIN_KEY=change-moi-aussi

# --- Google ------------------------------------------------------------------
# 1. https://console.cloud.google.com/ → créer un projet (si besoin)
# 2. "APIs & Services" → "OAuth consent screen" → type "External" → renseigne
#    juste le nom de l'app ("Middlwear") et ton email → Save. Tant que l'app
#    reste en statut "Testing", ajoute ton propre email dans "Test users"
#    (sinon Google refusera la connexion, y compris la tienne).
# 3. "APIs & Services" → "Credentials" → "Create Credentials" → "OAuth client ID"
# 4. Type d'application : "Web application"
# 5. Origine JavaScript autorisée : http://localhost:3000
# 6. URI de redirection autorisée : http://localhost:3000/api/auth/google/callback
# 7. Copie "Client ID" et "Client secret" ci-dessous, relance le serveur.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook ------------------------------------------------------------------
# 1. https://developers.facebook.com/apps → "Créer une application" → type "Consommateur"
# 2. Ajouter le produit "Facebook Login"
# 3. Paramètres > "URI de redirection OAuth valides" :
#    http://localhost:3000/api/auth/facebook/callback
# 4. Récupérer "ID de l'application" et "Clé secrète de l'application"
#    (Paramètres de base de l'app)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Instagram ------------------------------------------------------------------
# Le plus contraignant des trois : nécessite un compte Instagram PROFESSIONNEL
# (créateur ou entreprise) côté utilisateur final, et une appli Meta configurée
# avec le produit "Instagram API with Instagram Login" (l'ancienne "Instagram
# Basic Display API" est arrêtée depuis fin 2024).
# 1. https://developers.facebook.com/apps → même appli que Facebook ou une nouvelle
# 2. Ajouter le produit "Instagram" → "Instagram API with Instagram Login"
# 3. URI de redirection : http://localhost:3000/api/auth/instagram/callback
# 4. Vérifie les noms d'endpoints/scopes à jour dans la doc Meta au moment de la
#    config — ils changent plus souvent que ceux de Google/Facebook.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Stripe (paiement réel) -------------------------------------------------
# Sans STRIPE_SECRET_KEY, le site utilise le tunnel de paiement maquette existant
# (aucune vraie carte, rien de débité) — rien ne casse.
# 1. https://dashboard.stripe.com/register → crée un compte (ou connecte-toi)
# 2. Reste en mode "Test" (bascule en haut à gauche du dashboard) tant que tu
#    n'es pas prêt à encaisser de vrais paiements
# 3. https://dashboard.stripe.com/test/apikeys → copie la "Clé secrète" (sk_test_...)
STRIPE_SECRET_KEY=
# Devise des paiements — vérifie qu'elle est activée pour ton compte Stripe
# (Paramètres > Devises de paiement). "mad" par défaut (Dirham marocain).
STRIPE_CURRENCY=mad

# Webhook — confirme les paiements de façon fiable (indispensable en production,
# optionnel en local car server/routes/stripe.js vérifie aussi la session au retour) :
# 1. En local : installe la Stripe CLI (https://docs.stripe.com/stripe-cli), puis :
#      stripe listen --forward-to localhost:3000/api/stripe/webhook
#    la commande affiche une clé "whsec_..." à coller ci-dessous
# 2. En production : https://dashboard.stripe.com/webhooks → "Ajouter un endpoint"
#      URL : https://ton-domaine/api/stripe/webhook
#      Événement à écouter : checkout.session.completed
STRIPE_WEBHOOK_SECRET=
