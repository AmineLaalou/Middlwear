# Copie ce fichier en ".env" (dans server/) et remplis les valeurs.
# Sans clé pour un fournisseur, son bouton de connexion sociale reste
# désactivé côté site — rien ne casse, aucune clé n'est obligatoire.

# --- Général ---------------------------------------------------------------
PORT=3000
BASE_URL=http://localhost:3000
# Génère une vraie valeur secrète avant toute mise en ligne, ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-avant-la-mise-en-ligne

# --- Google ------------------------------------------------------------------
# 1. https://console.cloud.google.com/apis/credentials
# 2. Créer un projet (si besoin) → "Créer des identifiants" → "ID client OAuth"
# 3. Type d'application : "Application Web"
# 4. Origine JavaScript autorisée : http://localhost:3000
# 5. URI de redirection autorisée : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook ------------------------------------------------------------------
# 1. https://developers.facebook.com/apps → "Créer une application" → type "Consommateur"
# 2. Ajouter le produit "Facebook Login"
# 3. Paramètres > "URI de redirection OAuth valides" :
#    http://localhost:3000/api/auth/facebook/callback
# 4. Récupérer "ID de l'application" et "Clé secrète de l'application"
#    (Paramètres de base de l'app)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Instagram ------------------------------------------------------------------
# Le plus contraignant des trois : nécessite un compte Instagram PROFESSIONNEL
# (créateur ou entreprise) côté utilisateur final, et une appli Meta configurée
# avec le produit "Instagram API with Instagram Login" (l'ancienne "Instagram
# Basic Display API" est arrêtée depuis fin 2024).
# 1. https://developers.facebook.com/apps → même appli que Facebook ou une nouvelle
# 2. Ajouter le produit "Instagram" → "Instagram API with Instagram Login"
# 3. URI de redirection : http://localhost:3000/api/auth/instagram/callback
# 4. Vérifie les noms d'endpoints/scopes à jour dans la doc Meta au moment de la
#    config — ils changent plus souvent que ceux de Google/Facebook.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
